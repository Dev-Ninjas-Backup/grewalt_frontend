# App / email
EMAIL_USER=
EMAIL_PASS=
EMAIL_SMTP_SERVER=smtp.hostinger.com
EMAIL_SMTP_PORT=465
JWT_SECRET=

# Docker image (used by compose on the VPS)
DOCKER_USERNAME=softvence
PACKAGE_NAME=grewalt2
PACKAGE_VERSION=latest

# Postgres (docker compose db service)
POSTGRES_USER=grewalt_user
POSTGRES_PASSWORD=grewalt_password
POSTGRES_DB=grewalt_db
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_URL=postgresql://grewalt_user:grewalt_password@db:5432/grewalt_db
